                                 #pragma AVRPART MEMORY INT_SRAM SIZE 2048
                                 #pragma AVRPART MEMORY INT_SRAM START_ADDR 0x100
                                 
                                 
                                 
                                 ; ***** BOOTLOADER DECLARATIONS ******************************************
                                 .equ	NRWW_START_ADDR	= 0x3800
                                 .equ	NRWW_STOP_ADDR	= 0x3fff
                                 .equ	RWW_START_ADDR	= 0x0
                                 .equ	RWW_STOP_ADDR	= 0x37ff
                                 .equ	PAGESIZE	= 64
                                 .equ	FIRSTBOOTSTART	= 0x3f00
                                 .equ	SECONDBOOTSTART	= 0x3e00
                                 .equ	THIRDBOOTSTART	= 0x3c00
                                 .equ	FOURTHBOOTSTART	= 0x3800
                                 .equ	SMALLBOOTSTART	= FIRSTBOOTSTART
                                 .equ	LARGEBOOTSTART	= FOURTHBOOTSTART
                                 
                                 
                                 
                                 ; ***** INTERRUPT VECTORS ************************************************
                                 .equ	INT0addr	= 0x0002	; External Interrupt Request 0
                                 .equ	INT1addr	= 0x0004	; External Interrupt Request 1
                                 .equ	PCI0addr	= 0x0006	; Pin Change Interrupt Request 0
                                 .equ	PCI1addr	= 0x0008	; Pin Change Interrupt Request 0
                                 .equ	PCI2addr	= 0x000a	; Pin Change Interrupt Request 1
                                 .equ	WDTaddr	= 0x000c	; Watchdog Time-out Interrupt
                                 .equ	OC2Aaddr	= 0x000e	; Timer/Counter2 Compare Match A
                                 .equ	OC2Baddr	= 0x0010	; Timer/Counter2 Compare Match A
                                 .equ	OVF2addr	= 0x0012	; Timer/Counter2 Overflow
                                 .equ	ICP1addr	= 0x0014	; Timer/Counter1 Capture Event
                                 .equ	OC1Aaddr	= 0x0016	; Timer/Counter1 Compare Match A
                                 .equ	OC1Baddr	= 0x0018	; Timer/Counter1 Compare Match B
                                 .equ	OVF1addr	= 0x001a	; Timer/Counter1 Overflow
                                 .equ	OC0Aaddr	= 0x001c	; TimerCounter0 Compare Match A
                                 .equ	OC0Baddr	= 0x001e	; TimerCounter0 Compare Match B
                                 .equ	OVF0addr	= 0x0020	; Timer/Couner0 Overflow
                                 .equ	SPIaddr	= 0x0022	; SPI Serial Transfer Complete
                                 .equ	URXCaddr	= 0x0024	; USART Rx Complete
                                 .equ	UDREaddr	= 0x0026	; USART, Data Register Empty
                                 .equ	UTXCaddr	= 0x0028	; USART Tx Complete
                                 .equ	ADCCaddr	= 0x002a	; ADC Conversion Complete
                                 .equ	ERDYaddr	= 0x002c	; EEPROM Ready
                                 .equ	ACIaddr	= 0x002e	; Analog Comparator
                                 .equ	TWIaddr	= 0x0030	; Two-wire Serial Interface
                                 .equ	SPMRaddr	= 0x0032	; Store Program Memory Read
                                 
                                 .equ	INT_VECTORS_SIZE	= 52	; size in words
                                 
                                 #endif  /* _M328PDEF_INC_ */
                                 
                                 ; ***** END OF FILE ******************************************************
                                 
                                 ;		Mapeamento dos sinais:
                                 ;     S1 = Av. Prof. Sandoval Arroxelas entrando na avenida (sinal lateral)
                                 ;     S2 = avenida, sentido que sobe, faixa de conversao para a Sandoval
                                 ;     S3 = avenida, sentido que sobe, segue em frente
                                 ;     S4 = avenida, sentido que desce
                                 ;     P  = as duas faixas de pedestre sobre a avenida (abrem e fecham juntas,
                                 ;          por isso aqui tratamos como um unico sinal)
                                 
                                 .include "m328Pdef.inc"   
                                 
                                 ;***** Created: 2011-02-09 12:03 ******* Source: ATmega328P.xml **********
                                 ;*************************************************************************
                                 ;* A P P L I C A T I O N   N O T E   F O R   T H E   A V R   F A M I L Y
                                 ;* 
                                 ;* Number            : AVR000
                                 ;* File Name         : "m328Pdef.inc"
                                 ;* Title             : Register/Bit Definitions for the ATmega328P
                                 ;* Date              : 2011-02-09
                                 ;* Version           : 2.35
                                 ;* Support E-mail    : avr@atmel.com
                                 ;* Target MCU        : ATmega328P
                                 ;* 
                                 ;* DESCRIPTION
                                 ;* When including this file in the assembly program file, all I/O register 
                                 ;* names and I/O register bit names appearing in the data book can be used.
                                 ;* In addition, the six registers forming the three data pointers X, Y and 
                                 ;* Z have been assigned names XL - ZH. Highest RAM address for Internal 
                                 ;* SRAM is also defined 
                                 ;* 
                                 ;* The Register names are represented by their hexadecimal address.
                                 ;* 
                                 ;* The Register Bit names are represented by their bit number (0-7).
                                 ;* 
                                 ;* Please observe the difference in using the bit names with instructions
                                 ;* such as "sbr"/"cbr" (set/clear bit in register) and "sbrs"/"sbrc"
                                 ;* (skip if bit in register set/cleared). The following example illustrates
                                 ;* this:
                                 ;* 
                                 ;* in    r16,PORTB             ;read PORTB latch
                                 ;* sbr   r16,(1<<PB6)+(1<<PB5) ;set PB6 and PB5 (use masks, not bit#)
                                 ;* out   PORTB,r16             ;output to PORTB
                                 ;* 
                                 ;* in    r16,TIFR              ;read the Timer Interrupt Flag Register
                                 ;* sbrc  r16,TOV0              ;test the overflow flag (use bit#)
                                 ;* rjmp  TOV0_is_set           ;jump if set
                                 ;* ...                         ;otherwise do something else
                                 ;*************************************************************************
                                 
                                 #ifndef _M328PDEF_INC_
                                 #endif  /* _M328PDEF_INC_ */
                                 
                                 ; ***** END OF FILE ******************************************************
                                 
                                 ; Definicao de constantes e equacoes de tempo: 
                                 .equ F_CPU        = 16000000  ; Frequencia do oscilador (16 MHz)
                                 
                                 ;  Chaves para o modo de simulacao:
                                 ; 1 = depuracao no simulador do Microchip Studio.  
                                 ; 0 = versao final,usada  para o SimulIDE e para quando trabalharmos no protoboard.
                                 .equ SIMULACAO    = 0
                                 .if SIMULACAO                ; so e compilado quando SIMULACAO = 1 
                                 .else                        ; so e compilado quando SIMULACAO = 0
                                 .equ BAUD         = 9600     ; velocidade da porta serial em bps
                                 .equ UBRR_VAL     = (F_CPU/16/BAUD)-1   ; Calculo do registrador de baud rate (= 103)                            
                                 ;   Conta do Timer1, que gera o segundo:
                                 ;   prescaler 256  ->  16.000.000 / 256 = 62.500 contagens por segundo
                                 ;   em modo CTC o timer zera quando chega em OCR1A, ou seja, conta
                                 ;   OCR1A + 1 vezes; para 62.500 contagens, temos OCR1A = 62.499.
                                 .equ OCR1A_VAL    = 62499 ; Comparador para o Timer1 (1 segundo)
                                 .endif
                                 
                                 ;   Conta do Timer0, que varre os displays (5ms para a Multiplexacao):
                                 ;   prescaler 1024  ->  16.000.000 / 1024 = 15.625 contagens por segundo
                                 ;   queremos 5 ms = 1/200 s  ->  15.625 / 200 = 78 contagens
                                 ;   em CTC conta OCR0A + 1 vezes, logo temos OCR0A = 77.
                                 .equ OCR0A_VAL    = 77 ; Comparador para o Timer0 (5 ms)
                                 
                                 .equ NUM_ESTADOS  = 7         ; numero de  linhas da tabela de estados
                                 .equ TAM_ESTADO   = 4         ; quantidade de bytes por linha (duracao, PORTD, PORTB, livre)
                                 
                                 ; Bits dos LEDs em PORTD (pinos D2..D7)
                                 .equ S1_VM = (1<<2)           ; bit 2 = pino D2 = S1 vermelho
                                 .equ S1_AM = (1<<3)           ; bit 3 = pino D3 = S1 amarelo
                                 .equ S1_VD = (1<<4)           ; bit 4 = pino D4 = S1 verde
                                 .equ S2_VM = (1<<5)           ; bit 5 = pino D5 = S2 vermelho
                                 .equ S2_AM = (1<<6)           ; bit 6 = pino D6 = S2 amarelo
                                 .equ S2_VD = (1<<7)           ; bit 7 = pino D7 = S2 verde
                                 .equ MASK_D = 0b11111100      ; os 6 bits de PORTD usados por LEDs  (bits 0 e 1 ficam com a USART: RX e TX)
                                 
                                 ; Bits dos LEDs em PORTB (pinos D8..D13)
                                 .equ S3_VM = (1<<0)           ; bit 0 = pino D8  = S3 vermelho
                                 .equ S3_AM = (1<<1)           ; bit 1 = pino D9  = S3 amarelo
                                 .equ S4_AM = (1<<1)           ; MESMO bit do S3_AM: os dois amarelos dividem o mesmo
                                                               ; o pino D9 (olhando a tabela de estados, percebemos que S3 e S4 ficam amarelos exatamente no mesmo estado (q2) e em nenhum outro. 
                                 ;     Logo um  pino pode acender os dois, cada um com seu proprio resistor.)
                                 .equ S3_VD = (1<<2)           ; bit 2 = pino D10 = S3 verde
                                 .equ S4_VM = (1<<3)           ; bit 3 = pino D11 = S4 vermelho
                                 .equ S4_VD = (1<<4)           ; bit 4 = pino D12 = S4 verde
                                 .equ P_VM  = (1<<5)           ; bit 5 em 1  -> pino D13 alto  -> P vermelho
                                 .equ P_VD  = 0                ; bit 5 em 0  -> pino D13 baixo -> P verde
                                                               ; (vale 0 de proposito: somar 0 na tabela nao
                                                               ;  liga bit nenhum, e o pino fica em nivel baixo)
                                 .equ MASK_B = 0b00111111      ; os 6 bits de PORTB usados por LEDs
                                                               ; (bits 6 e 7 sao os pinos do cristal)
                                 
                                 ;  Pinos que selecionam qual display esta aceso
                                 .equ SEL_DEZ = (1<<PC5)       ; A5 em nivel alto -> liga o display das dezenas
                                 .equ SEL_UNI = (1<<PC4)       ; A4 em nivel alto -> liga o das unidades
                                 
                                 ; REGISTRADORES 
                                 .def tmp    = r16   ; temporario de uso geral 
                                 .def tmp2   = r17   ; segundo temporario, quando somente um nao for suficiente
                                 .def estado = r18   ; indice do estado atual na tabela (onde 0 = q1 e 6 = q7)
                                 .def seg    = r19   ; segundos que faltam para o estado atual terminar
                                 .def ledsD  = r20   ; copia dos bits de LED que vao para PORTD
                                 .def ledsB  = r21   ; copia dos bits de LED que vao para PORTB
                                 .def zero   = r22   ; registrador mantido sempre em 0 (o AVR nao tem um fixo)
                                 .def dez    = r23   ; digito das dezenas do contador (0..9)
                                 .def uni    = r24   ; digito das unidades do contador (0..9)
                                 .def mux    = r25   ; indica qual display foi aceso por ultimo: 0 = dezenas, 1 = unid.
                                 
                                 
                                 ; VARIAVEIS NA MEMORIA RAM
                                 .dseg                        
000100                           tx_ptr:  .byte 2              ; endereco (na memoria flash) do proximo caractere a enviar pela serial.  2 bytes = ponteiro de 16 bits
000102                           tx_next: .byte 2              ; endereco da proxima string da fila; 0 = fila vazia.
                                 
                                 ; TABELA DE VETORES DE INTERRUPCAO
                                 ; Quando uma interrupcao ocorre, o processador salta automaticamente para um
                                 ; endereco fixo da flash, diferente para cada fonte. Colocamos em cada um
                                 ; desses enderecos um salto para a nossa rotina.
                                 
                                 .cseg                         
                                 
                                 .org 0x0000                   ; endereco 0: para onde o chip vai ao ligar
000000 c033                          rjmp reset                ; desvia para a inicializacao
                                 
                                 .org OC1Aaddr                 ; Interrupcao do Timer1 (Compare Match A)
000016 c059                          rjmp isr_timer1           ; -> nossa rotina do tique de 1 segundo
                                 
                                 .org OC0Aaddr                 ; Interrupcao do Timer0 (Compare Match A)
00001c c068                          rjmp isr_timer0           ; -> nossa rotina da varredura dos displays
                                 
                                 .org UDREaddr                 ; Interrupcao da USART (Registrador de dados vazio)
000026 c070                          rjmp isr_udre             ; -> nossa rotina que envia o proximo caractere
                                 
                                 .org INT_VECTORS_SIZE         ; pula o resto da tabela de vetores; 
                                 
                                 reset:
                                     ; A pilha guarda o endereco de retorno dos "rcall" no topo da RAM e o que as ISRs empilham. 
000034 e008                          ldi  tmp, high(RAMEND)    ; byte alto do ultimo endereco da RAM para a parte alta do ponteiro de pilha
000035 bf0e                          out  SPH, tmp             
000036 ef0f                          ldi  tmp, low(RAMEND)     ; byte baixo para a parte baixa
000037 bf0d                          out  SPL, tmp             
                                 
000038 2766                          clr  zero                 ; zera o registrador que servira de constante 0
000039 2799                          clr  mux                  ; comeca a varredura pelas dezenas
                                 
                                     ; direcao dos pinos (DDR = 1 significa saida)
00003a ef0c                          ldi  tmp, MASK_D          ; 0b11111100
00003b b90a                          out  DDRD, tmp            ; pinos PD2..PD7 viram saidas (LEDs); PD0/PD1 ficam como estao, para a USART usar
00003c e30f                          ldi  tmp, MASK_B          ; 0b00111111
00003d b904                          out  DDRB, tmp            ; pinos PB0..PB5 viram saidas (LEDs)
00003e e30f                          ldi  tmp, 0x3F            ; 0b00111111
00003f b907                          out  DDRC, tmp            ; pinos PC0..PC3 viram saidas (BCD) e PC4/PC5 saidas  (selecao dos displays)
                                                               
000040 b968                          out  PORTC, zero          ; comeca com os dois displays apagados e o BCD em 0
                                 
                                     ;  Inicializa o hardware da USART gravando o valor UBRR_VAL nos registradores UBRR0H/L e habilitando a transmissao (TXEN0) no formato 8N1. 
000041 e000                          ldi  tmp, high(UBRR_VAL)  ; byte alto do divisor de velocidade
000042 9300 00c5                     sts  UBRR0H, tmp          ; (UBRR0H/L ficam fora do alcance de "out",
000044 e607                          ldi  tmp, low(UBRR_VAL)   ;  por isso "sts", que aceita endereco de 16 bits)
000045 9300 00c4                     sts  UBRR0L, tmp          ; grava o byte baixo do divisor
000047 e008                          ldi  tmp, (1<<TXEN0)      ; TXEN0 = habilita o transmissor
000048 9300 00c1                     sts  UCSR0B, tmp          
00004a e006                          ldi  tmp, (1<<UCSZ01)|(1<<UCSZ00)  ; UCSZ01:UCSZ00 = 11 -> 8 bits por quadro
00004b 9300 00c2                     sts  UCSR0C, tmp          ; grava o formato do quadro
                                 
                                 
00004d 9360 0102                     sts  tx_next,   zero		   ; fila comeca vazia (byte baixo)
00004f 9360 0103                     sts  tx_next+1, zero		   ; byte alto
000051 e204                          ldi  tmp,  low(str_banner*2)   ; endereco do banner na flash.  O "*2" e porque rotulos da flash sao contados em palavras de 16 bits, e "lpm" le bytes
000052 e012                          ldi  tmp2, high(str_banner*2)  
000053 d086                          rcall agenda_string       ; entrega a string a serial
                                 
                                     ; estado inicial
000054 2722                          clr  estado               ; indice 0 = estado q1
000055 d06f                          rcall carrega_estado      ; le a linha q1: tempo, LEDs e mensagem
000056 d09d                          rcall separa_digitos      ; converte os segundos em dezena e unidade
                                 
                                     ; Timer0: varredura dos displays, 1 interrupcao a cada 5 ms
000057 e002                          ldi  tmp, (1<<WGM01)      ; WGM01 = modo CTC: o timer conta ate OCR0A e volta a zero sozinho
000058 bd04                          out  TCCR0A, tmp          
000059 e40d                          ldi  tmp, OCR0A_VAL       
00005a bd07                          out  OCR0A, tmp           ; valor de comparacao (o topo da contagem)
00005b e005                          ldi  tmp, (1<<CS02)|(1<<CS00)   ; CS02:CS00 = 101 -> prescaler 1024.
00005c bd05                          out  TCCR0B, tmp          ; escrever os bits CS liga o timer OCIE0A = gera interrupcao quando TCNT0 = OCR0A
00005d e002                          ldi  tmp, (1<<OCIE0A)     ; a partir daqui o Timer0 interrompe a cada 5 ms
00005e 9300 006e                     sts  TIMSK0, tmp          
                                 
                                     ; Timer1: relogio da maquina, 1 interrupcao por segundo
000060 9360 0080                     sts  TCCR1A, zero         ; nenhuma saida PWM nos pinos; modo normal
                                     ; OCR1A tem 16 bits e e escrito em dois acessos.  O hardware exige o byte
                                     ; ALTO primeiro: ele fica num registrador temporario e so e gravado junto com o baixo, para o timer nunca ver meio valor.
000062 ef04                          ldi  tmp, high(OCR1A_VAL) ; carrega o byte alto de 62499
000063 9300 0089                     sts  OCR1AH, tmp          ; byte alto primeiro
000065 e203                          ldi  tmp, low(OCR1A_VAL)  ; carrega o byte baixo
000066 9300 0088                     sts  OCR1AL, tmp          ; byte baixo depois: agora os 16 bits valem
000068 e00c                          ldi  tmp, (1<<WGM12)|(1<<CS12)  ; WGM12 = CTC com topo em OCR1A;
000069 9300 0081                     sts  TCCR1B, tmp          ; CS12 = 100 -> prescaler 256 e liga o timer
00006b e002                          ldi  tmp, (1<<OCIE1A)     ; habilita a interrupcao de comparacao A
00006c 9300 006f                     sts  TIMSK1, tmp          ; a partir daqui o Timer1 interrompe a cada 1 s
                                 
00006e 9478                          sei                       ;liga o bit I do registrador de status e libera as interrupcoes globais, a partir daqui o programa passa a ser movido so por elas
                                 
                                 loop:
00006f cfff                          rjmp loop                 ; fica girando aqui ate uma interrupcao ocorrer, e um salto para si mesmo, nao fica lendo bit e voltando atras pra checar de novo
                                 
                                 ; Rotina isr_timer1 - INTERRUPCAO DO TIMER1, uma vez por segundo
                                 isr_timer1:
                                     ; A cada segundo, reduz a contagem regressiva. Ao alcancar 0, avanca para o proximo estado da FSM,
                                 	; atualiza os registradores de saida dos LEDs e agenda a nova mensagem serial. 
000070 930f                          push tmp                  ; salva contexto
000071 b70f                          in   tmp, SREG            ; le o registrador de status (guarda as flags Z, C, N...)
000072 930f                          push tmp                  
000073 931f                          push tmp2                 ; salva tmp2
000074 93ef                          push ZL                   ; salva o ponteiro Z (usado por carrega_estado) nas suas duas metades
000075 93ff                          push ZH                   
000076 953a                          dec  seg                  ; Decrementa o tempo restante do estado
000077 f429                          brne t1_atualiza          ; Se ainda nao eh zero, apenas atualiza o display
000078 9523                          inc  estado               ; Se zerou, passa para o proximo estado
000079 3027                          cpi  estado, NUM_ESTADOS  ; passou do ultimo estado (q7)? --> nao: segue com o indice novo e sim: o ciclo reinicia em q1
00007a f008                          brlo t1_carrega           
00007b 2722                          clr  estado				  ;  fecha o ciclo, fazendo o q7 voltar para o q1        
                                 t1_carrega:
00007c d048                          rcall carrega_estado      ; Le novos valores da Flash
                                 t1_atualiza:
00007d d076                          rcall separa_digitos      ; Converte "seg" para BCD (dezena/unidade)
                                 
00007e 91ff                          pop  ZH                   ; devolve os registradores na ordem inversa da que foram empilhados
00007f 91ef                          pop  ZL                   
000080 911f                          pop  tmp2                
000081 910f                          pop  tmp                  
000082 bf0f                          out  SREG, tmp            ; restaura os flags
000083 910f                          pop  tmp                  
000084 9518                          reti                      ; "return from interrupt": volta e reabilita
                                                               ; as interrupcoes
                                 
                                 ; isr_timer0 - INTERRUPCAO DO TIMER0, a cada 5 ms
                                 ;  A cada 5 ms, alterna qual display esta ligado.  
                                 isr_timer0:
000085 930f                          push tmp                  ; salva tmp
000086 b70f                          in   tmp, SREG            ; le os flags
000087 930f                          push tmp                  ; e salva tambem
                                 
000088 2399                          tst  mux                  ; Verifica se acendeu dezenas (0) ou unidades (1)
000089 f429                          brne t0_unidades          
                                     
00008a 2f07                          mov  tmp, dez             ; Pega o digito da dezena
00008b 6200                          ori  tmp, SEL_DEZ         ; Ativa o bit de selecao do display 1 (PC5)
00008c b908                          out  PORTC, tmp           ; Envia BCD + Selecao de uma so vez
00008d e091                          ldi  mux, 1               
00008e c004                          rjmp t0_sai               ; pula o trecho das unidades
                                 
                                 t0_unidades:
00008f 2f08                          mov  tmp, uni             ; Pega o digito da unidade
000090 6100                          ori  tmp, SEL_UNI         ; Ativa o bit de selecao do display 2 (PC4)
000091 b908                          out  PORTC, tmp           ; escrita unica: BCD + selecao
000092 2799                          clr  mux                  ; proximo tique volta a ser das dezenas
                                 
                                 t0_sai:
000093 910f                          pop  tmp                  ; recupera o SREG salvo
000094 bf0f                          out  SREG, tmp            ; restaura os flags
000095 910f                          pop  tmp                  ; restaura tmp
000096 9518                          reti                      ; volta
                                 
                                 ; isr_udre - INTERRUPCAO DA USART, "registrador de transmissao vazio"
                                 ; Sempre que o hardware envia um caractere e fica livre para o proximo, ele dispara a interrupcao UDRE
                                 ; A ISR pega o proximo caractere da string armazenada na Flash e o escreve no registrador UDR0
                                 ; sem travar o processador com lacos de espera.
                                 isr_udre:
000097 930f                          push tmp                  ; salva tmp
000098 b70f                          in   tmp, SREG            ; le os flags
000099 930f                          push tmp                  ; e salva o SREG tambem
00009a 93ef                          push ZL                   
00009b 93ff                          push ZH                   
                                 
00009c 91e0 0100                     lds  ZL, tx_ptr           ; Z = endereco do proximo caractere
00009e 91f0 0101                     lds  ZH, tx_ptr+1         ; ...byte alto do ponteiro
0000a0 9105                          lpm  tmp, Z+              ; le o caractere da flash e ja avanca Z
0000a1 2300                          tst  tmp                  ; o caractere e 0? 0 marca o fim da string
0000a2 f039                          breq udre_fim             
                                 
0000a3 9300 00c6                     sts  UDR0, tmp            ; escreve no registrador de dados: o hardware transmite esse byte bit a bit
0000a5 93e0 0100                     sts  tx_ptr,   ZL         ; guarda o ponteiro ja avancado para a proxima
0000a7 93f0 0101                     sts  tx_ptr+1, ZH         ; chamada desta ISR
0000a9 c015                          rjmp udre_sai             
                                 
                                 udre_fim:
                                     
0000aa 91e0 0102                     lds  ZL, tx_next          ; le o endereco guardado na fila
0000ac 91f0 0103                     lds  ZH, tx_next+1        ; ...byte alto
0000ae 2f0e                          mov  tmp, ZL              
0000af 2b0f                          or   tmp, ZH              
0000b0 f049                          breq udre_vazio           ; zero = fila vazia, nada mais a enviar
                                 
0000b1 93e0 0100                     sts  tx_ptr,   ZL         
0000b3 93f0 0101                     sts  tx_ptr+1, ZH         
0000b5 9360 0102                     sts  tx_next,   zero      
0000b7 9360 0103                     sts  tx_next+1, zero     
0000b9 c005                          rjmp udre_sai             ; UDRIE0 continua ligada, entao a proxima interrupcao ja envia o 1o caractere dela
                                 
                                 udre_vazio:
0000ba 9100 00c1                     lds  tmp, UCSR0B          ; nada mais a enviar:
0000bc 7d0f                          cbr  tmp, (1<<UDRIE0)     ; desliga a interrupcao UDRE, senao ela ficaria disparando sem parar (o registrador esta vazio o tempo todo)
0000bd 9300 00c1                     sts  UCSR0B, tmp          
                                                               
                                 
                                 udre_sai:
0000bf 91ff                          pop  ZH                   ; restaura tudo na ordem inversa
0000c0 91ef                          pop  ZL                   ; ponteiro Z
0000c1 910f                          pop  tmp                  ; SREG salvo
0000c2 bf0f                          out  SREG, tmp            ; restaura os flags
0000c3 910f                          pop  tmp                  ; tmp original
0000c4 9518                          reti                      ; volta ao ponto interrompido
                                 
                                 
                                 
                                 carrega_estado:
                                     ; calcula o endereco da linha: base + indice * 4 
0000c5 efea                          ldi  ZL, low(tabela_estados*2)   ; Z aponta para o inicio da tabela.
0000c6 e0f1                          ldi  ZH, high(tabela_estados*2)  ; "*2" converte palavras em bytes
                                                                      
0000c7 2f02                          mov  tmp, estado          ; tmp = indice do estado
0000c8 0f00                          lsl  tmp                  ; desloca 1 bit a esquerda = multiplica por 2
0000c9 0f00                          lsl  tmp                  ; de novo = multiplica por 4 (TAM_ESTADO)
0000ca 0fe0                          add  ZL, tmp              ; soma o deslocamento ao byte baixo de Z
0000cb 1ff6                          adc  ZH, zero             ; e propaga o "vai um" para o byte alto (adc soma o carry; por isso zero existe)
                                                              
                                 
0000cc 9135                          lpm  seg,   Z+            ; byte 1: duracao do estado, em segundos
0000cd 9145                          lpm  ledsD, Z+            ; byte 2: bits dos LEDs de PORTD (S1 e S2)
0000ce 9155                          lpm  ledsB, Z+            ; byte 3: bits dos LEDs de PORTB (S3, S4 e P)
                                                               
                                 
0000cf d01b                          rcall atualiza_leds       
                                     ;escolhe a mensagem de status deste estado 
0000d0 e1e6                          ldi  ZL, low(tab_strings*2)    ; Z aponta para o inicio do vetor
0000d1 e0f2                          ldi  ZH, high(tab_strings*2)   
0000d2 2f02                          mov  tmp, estado          ; indice do estado
0000d3 0f00                          lsl  tmp                  ; x2, porque cada ponteiro ocupa 2 bytes
0000d4 0fe0                          add  ZL, tmp              ; soma ao endereco base
0000d5 1ff6                          adc  ZH, zero             ; propaga o carry
0000d6 9105                          lpm  tmp,  Z+             ; byte baixo do endereco da string
0000d7 9114                          lpm  tmp2, Z              ; byte alto
0000d8 d001                          rcall agenda_string       ; entrega essa string a serial
0000d9 9508                          ret                       ; volta para quem chamou (reset ou isr_timer1)
                                 
                                 
                                 agenda_string:
0000da 91e0 00c1                     lds  ZL, UCSR0B           ; le a configuracao atual da USART
0000dc fde5                          sbrc ZL, UDRIE0           ; a interrupcao UDRE esta ligada? "sbrc" = pula a proxima instrucao se o bit = 0
                                                               ; bit = 1: ha transmissao em curso -> vai p/ fila
0000dd c008                          rjmp ag_fila              
                                 
0000de 9300 0100                     sts  tx_ptr,   tmp        ; serial livre: esta string vira a atual
0000e0 9310 0101                     sts  tx_ptr+1, tmp2       ; ...byte alto do ponteiro
0000e2 62e0                          sbr  ZL, (1<<UDRIE0)      ; liga a interrupcao "registrador vazio"
0000e3 93e0 00c1                     sts  UCSR0B, ZL           ; como ele ja esta vazio, a ISR dispara em seguida e comeca a enviar volta; o envio segue sozinho, por interrupcao
                                                               
0000e5 9508                          ret                       
                                 
                                 ag_fila:
0000e6 9300 0102                     sts  tx_next,   tmp       ; ocupada: a string espera a vez na fila
0000e8 9310 0103                     sts  tx_next+1, tmp2      ; ...byte alto do ponteiro
0000ea 9508                          ret                       ; a ISR a pegara quando terminar a atual
                                 
                                 atualiza_leds:
0000eb b10b                          in   tmp, PORTD           ; le o estado atual da porta D
0000ec 7003                          andi tmp, 0x03            ; zera PD2..PD7 (os LEDs) e mantem PD0/PD1, que pertencem a USART e nao podem ser mexido
0000ed 2b04                          or   tmp, ledsD           ; acrescenta os bits das cores deste estado
0000ee b90b                          out  PORTD, tmp           ; escreve: os LEDs de S1 e S2 mudam juntos
0000ef b105                          in   tmp, PORTB           
0000f0 7c00                          andi tmp, 0xC0            ; zera PB0..PB5 e mantem PB6/PB7 (cristal)
0000f1 2b05                          or   tmp, ledsB           ; acrescenta as cores de S3, S4 e P
0000f2 b905                          out  PORTB, tmp           
0000f3 9508                          ret                       ; o estado ja esta visivel nos 14 LEDs
                                 
                                 
                                 separa_digitos:
0000f4 2f03                          mov  tmp, seg             ; copia o valor, para nao destruir "seg"
0000f5 2777                          clr  dez                  ; comeca com zero dezenas
                                 sd_loop:
0000f6 300a                          cpi  tmp, 10              ; ainda da para tirar 10? menor que 10: acabou, o que sobrou  a unidade tira 10
0000f7 f018                          brlo sd_pronto           
0000f8 500a                          subi tmp, 10              
0000f9 9573                          inc  dez                  
0000fa cffb                          rjmp sd_loop             
                                 sd_pronto:
0000fb 2f80                          mov  uni, tmp             ; conta maus uma dezena repete o resto (0..9) e o digito das unidades
0000fc 9508                          ret                       ; dez e uni sao lidos pela ISR do Timer0
                                 
                                 ; TABELA DE ESTADOS (gravada na memoria flash)
                                 ; Cada linha tem 4 bytes:
                                 ;   1) duracao do estado, em segundos
                                 ;   2) bits dos LEDs de PORTD  (S1 e S2)
                                 ;   3) bits dos LEDs de PORTB  (S3, S4 e P)
                                 ;   4) byte reservado, so para a linha ter 4 bytes e o calculo do endereco
                                 ;      ser um deslocamento de 2 bits ("lsl" duas vezes em carrega_estado)
                                 ;
                                 ;  Estado (codigo) | S1 | S2 | S3 | S4 | P  | Duracao | Quem passa
                                 ;    q1   (000)    | Vm | Vm | Vd | Vd | Vm |  53 s   | avenida nos 2 sentidos
                                 ;    q2   (001)    | Vm | Vm | Am | Am | Vm |   4 s   | avenida fechando
                                 ;    q3   (010)    | Vd | Vm | Vm | Vm | Vd |  39 s   | rua lateral + pedestre
                                 ;    q4   (011)    | Am | Vm | Vm | Vm | Vd |   4 s   | lateral fechando
                                 ;    q5   (100)    | Vm | Vm | Vm | Vm | Vd |  15 s   | vermelho geral: so pedestre
                                 ;    q6   (101)    | Vm | Vd | Vd | Vm | Vm |  23 s   | sobe: reto + conversao
                                 ;    q7   (110)    | Vm | Am | Vd | Vm | Vm |   4 s   | conversao fechando
                                 
                                 ;  Ciclo total: 142 s.  Depois de q7 o ciclo recomeca em q1.
                                 ; Tres regras que a tabela respeita, e que valem citar na apresentacao:
                                 ;   - nenhum sinal passa de verde direto para vermelho: sempre ha amarelo;
                                 ;   - o pedestre so fica verde quando S2, S3 e S4 estao vermelhos, porque as
                                 ;     duas faixas atravessam a avenida;
                                 ;   - todo amarelo dura 4 s, medidos no estudo de campo.
                                 
                                 tabela_estados:
                                     ;   dur  PORTD (S1, S2)     PORTB (S3, S4, P)       reserva
0000fd 2435
0000fe 0034                          .db 53,  S1_VM|S2_VM,       S3_VD|S4_VD|P_VM,       0   ; q1
0000ff 2404
000100 0022                          .db  4,  S1_VM|S2_VM,       S3_AM|S4_AM|P_VM,       0   ; q2 (um bit so acende os dois amarelos
                                                                                             ;     
000101 3027
000102 0009                          .db 39,  S1_VD|S2_VM,       S3_VM|S4_VM|P_VD,       0   ; q3
000103 2804
000104 0009                          .db  4,  S1_AM|S2_VM,       S3_VM|S4_VM|P_VD,       0   ; q4
000105 240f
000106 0009                          .db 15,  S1_VM|S2_VM,       S3_VM|S4_VM|P_VD,       0   ; q5
000107 8417
000108 002c                          .db 23,  S1_VM|S2_VD,       S3_VD|S4_VM|P_VM,       0   ; q6
000109 4404
00010a 002c                          .db  4,  S1_VM|S2_AM,       S3_VD|S4_VM|P_VM,       0   ; q7
                                 
                                 
                                 ; ".dw" grava palavras de 16 bits; cada uma e o endereco (em bytes) de uma
                                 ; string.  A ordem tem de ser a mesma da tabela de estados.
                                 tab_strings:
00010b 0272
00010c 02c2
00010d 0314
00010e 0364                          .dw str_e1*2, str_e2*2, str_e3*2, str_e4*2
00010f 03b4
000110 0406
000111 0456                          .dw str_e5*2, str_e6*2, str_e7*2
                                 
                                 
